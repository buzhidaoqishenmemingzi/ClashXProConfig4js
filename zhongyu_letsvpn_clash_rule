# =========================================================
# 规则逻辑（优先级从上到下）
# =========================================================
rules:
  # ---- 1. 自定义规则（最高优先级）----
  - RULE-SET,custom-direct,DIRECT
  - RULE-SET,custom-proxy,🚀 代理出口

  # ---- 2. 局域网直连 ----
  - RULE-SET,lan,DIRECT

  # ---- 3. 广告屏蔽 ----
  - RULE-SET,ban-ad,REJECT
  - RULE-SET,ban-program-ad,REJECT
  - RULE-SET,ban-easylist-china,REJECT
  - RULE-SET,reject-domain,REJECT

  # ---- 4. AI 服务走代理 ----
  - RULE-SET,openai,🚀 代理出口
  - RULE-SET,claude,🚀 代理出口
  - RULE-SET,gemini,🚀 代理出口
  - RULE-SET,copilot,🚀 代理出口

  # ---- 5. 流媒体走代理 ----
  - RULE-SET,netflix,🚀 代理出口
  - RULE-SET,youtube,🚀 代理出口
  - RULE-SET,spotify,🚀 代理出口
  - RULE-SET,tiktok,🚀 代理出口
  - RULE-SET,proxy-media,🚀 代理出口

  # ---- 6. Telegram 走代理 ----
  - RULE-SET,telegram,🚀 代理出口

  # ---- 7. 苹果服务直连 ----
  - RULE-SET,apple,DIRECT

  # ---- 8. 国内直连 ----
  - RULE-SET,google-cn,DIRECT
  - RULE-SET,china-domain,DIRECT
  - RULE-SET,china-company-ip,DIRECT
  - RULE-SET,china-ip,DIRECT
  - RULE-SET,download,DIRECT

  # ---- 9. GFW 走代理 ----
  - RULE-SET,proxy-gfw,🚀 代理出口
  - RULE-SET,proxy-lite,🚀 代理出口

  # ---- 10. 兜底 GEOIP 补漏 ----
  - GEOIP,CN,DIRECT

  # ---- 11. 默认直连 ----
  - MATCH,DIRECT