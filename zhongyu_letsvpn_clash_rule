# =========================================================
# 基础设置
# =========================================================
mixed-port: 7890
allow-lan: false      # 本机使用建议设为 false，安全性更高
mode: rule
log-level: info
ipv6: false

# 安全性加固：外部控制仅限本机，防止远程篡改
external-controller: '127.0.0.1:9090'
secret: 'ENx$JaovpsT1'

# =========================================================
# TUN 模式 (Mac 实现 UDP 支持的关键)
# =========================================================
tun:
  enable: true
  stack: system
  auto-route: true
  auto-detect-interface: true
  dns-hierarchical: true

# =========================================================
# DNS 优化
# =========================================================
dns:
  enable: true
  listen: '127.0.0.1:8853'
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16

  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29

  nameserver:
    - 'https://dns.alidns.com/dns-query'
    - 'https://doh.pub/dns-query'

  fallback:
    - 'https://dns.google/dns-query'
    - 'https://1.1.1.1/dns-query'

  nameserver-policy:
    "geosite:cn": ["https://dns.alidns.com/dns-query", "https://doh.pub/dns-query"]
    "geosite:category-games@cn": [223.5.5.5]

# =========================================================
# 节点
# =========================================================
proxies:
  - name: 'letsvpn'
    type: socks5
    server: 192.168.55.188
    port: 7897
    username: "miniletsvpn"
    password: "ehfisBzi5Ac9uLb"
    udp: true

# =========================================================
# 策略组（仅两组）
# =========================================================
proxy-groups:
  # a. 代理出口：固定走 letsvpn，也可手动切直连
  - name: Proxy
    type: select
    udp: true
    proxies:
      - 'letsvpn'
      - DIRECT

  # b. 漏网之鱼：未匹配流量，默认直连，可随时切换
  - name: 漏网之鱼
    type: select
    udp: true
    proxies:
      - DIRECT
      - 'letsvpn'

