# =========================================================
# 基础设置
# =========================================================
mixed-port: 7890
allow-lan: false      # 本机使用建议设为 false，安全性更高
mode: rule
log-level: info
ipv6: false

# 安全性加固：外部控制仅限本机，防止远程篡改
external-controller: '127.0.0.1:9090'
secret: 'ENx$JaovpsT1'

# =========================================================
# TUN 模式 (Mac 实现 UDP 支持的关键)
# =========================================================
tun:
  enable: true
  stack: system
  auto-route: true
  auto-detect-interface: true
  dns-hierarchical: true

# =========================================================
# DNS 优化 (精简了冗余的 nameserver-policy)
# =========================================================
dns:
  enable: true
  listen: '127.0.0.1:8853'
  enhanced-mode: fake-ip
  fake-ip-range: 198.18.0.1/16
  
  default-nameserver:
    - 223.5.5.5
    - 119.29.29.29
  
  nameserver:
    - 'https://dns.alidns.com/dns-query'
    - 'https://doh.pub/dns-query'
    
  fallback:
    - 'https://dns.google/dns-query'
    - 'https://1.1.1.1/dns-query'
  
  # 使用 geosite 代替手动列出几百个域名，逻辑更强
  nameserver-policy:
    "geosite:cn": ["https://dns.alidns.com/dns-query", "https://doh.pub/dns-query"]
    "geosite:category-games@cn": [223.5.5.5]

# =========================================================
# 节点与认证 (加上了你刚才要求的密码)
# =========================================================
proxies:
  - name: 'letsvpn'
    type: socks5
    server: 192.168.55.188
    port: 7897
    username: "miniletsvpn"           # 需在 188 机器同步设置
    password: "ehfisBzi5Ac9uLb"    # 需在 188 机器同步设置
    udp: true

# =========================================================
# 策略组 (极简单组流)
# =========================================================
proxy-groups:
  - name: 🚀 代理出口
    type: select
    udp: true
    proxies:
      - 'letsvpn'
      - DIRECT

# =========================================================
# 规则逻辑
# =========================================================
rules:
  # 1. 基础绕过
  - DOMAIN-KEYWORD,aria2,DIRECT
  - DOMAIN-SUFFIX,smtp,DIRECT
  - DOMAIN-SUFFIX,66zhang.com,DIRECT
  - DOMAIN-SUFFIX,bano.co,DIRECT
  - DOMAIN-SUFFIX,llvip.net,DIRECT
  - DOMAIN-SUFFIX,boltfaas.com,DIRECT
  - DOMAIN-SUFFIX,boltbaas.com,DIRECT

  # 2. 局域网直连
  - GEOIP,LAN,DIRECT
  
  # 3. 广告/测速屏蔽 (可选)
  - GEOSITE,category-ads-all,REJECT

  # 4. 常见的中国流量：直接走直连
  - GEOSITE,cn,DIRECT
  - GEOIP,CN,DIRECT

  # 5. 最后兜底
  - MATCH,🚀 代理出口